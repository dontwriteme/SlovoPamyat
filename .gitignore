# Svetoch / СВЕТОЧ — Android (Java + Gradle)
# Place this file in the project root, next to settings.gradle.

# Gradle caches and build outputs
.gradle/
**/build/
**/.gradle/

# Android Studio / IntelliJ local configuration
.idea/
*.iml
out/

# Local Android SDK location and developer-specific properties
local.properties
**/local.properties

# Android generated files
captures/
.externalNativeBuild/
.cxx/
**/.cxx/
.kotlin/
**/.kotlin/
*.hprof
*.heapdump

# Built applications and archives (not source code)
*.apk
*.aab
*.apks
*.aar

# Signing credentials and local secrets
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
key.properties
signing.properties
secrets.properties
.env
.env.*
!.env.example

# Temporary, backup, and log files
*.log
*.tmp
*.bak
*.orig
*.rej
*~

# OS-specific files
.DS_Store
Thumbs.db
Desktop.ini

# Keep these files in Git:
# gradlew, gradlew.bat, gradle/wrapper/*, *.gradle, gradle.properties
# app/src/main/assets/synodal.json and synodal.sidx (offline Bible + search index)
# app/src/main/java/, app/src/main/res/, AndroidManifest.xml
# .github/workflows/*
